{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": false },
    { "source": "/index", "destination": "/home", "permanent": false },
    { "source": "/shop/index", "destination": "/shop", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/image", "destination": "/api/shop?kind=image" },
    { "source": "/api/admin/image", "destination": "/api/admin/shop?kind=image" },
    { "source": "/api/admin/check", "destination": "/api/admin/login?action=check" },
    { "source": "/api/admin/logout", "destination": "/api/admin/login?action=logout" }
  ]
}
